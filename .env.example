# Copy to .env (local) or set in Vercel project settings (Production + Preview).
# .gitignore covers every .env* except this file.

# --- Public by design (inlined into the client bundle at build time) ---------
# The only three VITE_ vars this repo permits. The Supabase URL and anon key
# are safe to publish: they appear in every Supabase browser app, and row-level
# security (supabase/migrations) is the enforcement. CI fails the build if any
# other VITE_ variable appears in the source.
VITE_SITE_URL=https://summonspeakers.com
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only (never VITE_-prefixed, never shipped to the browser) --------
# Same project URL as above, kept separate so the server reads it at runtime
# rather than build time.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Bypasses RLS. Treat like a database root password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transactional email (Resend). Without these, enquiries and listings are still
# persisted but no email is sent.
RESEND_API_KEY=re_...
RESEND_FROM="SummonSpeakers <hello@summonspeakers.com>"
# Where enquiry and listing notifications land.
ADMIN_EMAIL=you@example.com
